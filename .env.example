# Copy to .env (never commit .env). Values left empty on purpose.
# Required
TOMTOM_API_KEY=
APP_PASSWORD=
SESSION_SECRET=

# Optional: read-only access for Home Assistant
API_READ_TOKEN=
EMBED_TOKEN=

# Optional: separate, restricted key only for MAP_TILE_MODE=direct (browser-visible)
TOMTOM_MAP_KEY=

# Network / hosting
HOST_PORT=8080
BASE_PATH=
PUBLIC_BASE_URL=
TRUSTED_PROXIES=
COOKIE_SECURE=auto
FRAME_ANCESTORS='self'

# Collection and budget (defaults shown in README)
COLLECTION_INTERVAL_MINUTES=15
ROUTING_MONTHLY_ALLOWANCE=20000
ROUTING_SAFETY_RESERVE=2000
ROUTING_OTHER_APPS_ALLOWANCE=0
ROUTING_OPENING_USAGE=0
ALLOWANCE_RESET_TIMEZONE=UTC
ALLOWANCE_RESET_CONFIRMED=false
